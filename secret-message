
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Whispers & Letters — A Secret Message For You</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Canvas Confetti -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            handwriting: ['"Caveat"', 'cursive'],
          },
          colors: {
            rose: {
              50: '#fff1f2',
              100: '#ffe4e6',
              200: '#fecdd3',
              400: '#fb7185',
              500: '#f43f5e',
              600: '#e11d48',
            },
            warm: {
              50: '#faf7f5',
              100: '#f5efe6',
            }
          },
          animation: {
            'float-slow': 'float 6s ease-in-out infinite',
            'float-delay': 'float 7s ease-in-out 2s infinite',
            'pulse-soft': 'pulseSoft 3s ease-in-out infinite',
            'shake': 'shake 0.4s ease-in-out',
          },
          keyframes: {
            float: {
              '0%, 100%': { transform: 'translateY(0px) rotate(0deg)' },
              '50%': { transform: 'translateY(-12px) rotate(2deg)' },
            },
            pulseSoft: {
              '0%, 100%': { transform: 'scale(1)', opacity: '0.8' },
              '50%': { transform: 'scale(1.05)', opacity: '1' },
            },
            shake: {
              '0%, 100%': { transform: 'translateX(0)' },
              '20%, 60%': { transform: 'translateX(-8px)' },
              '40%, 80%': { transform: 'translateX(8px)' },
            }
          }
        }
      }
    }
  </script>

  <style>
    /* Custom floating background particles */
    .bg-blobs {
      background: radial-gradient(circle at 15% 20%, rgba(254, 205, 211, 0.6) 0%, transparent 40%),
                  radial-gradient(circle at 85% 80%, rgba(253, 186, 116, 0.4) 0%, transparent 45%),
                  radial-gradient(circle at 50% 50%, rgba(244, 114, 182, 0.25) 0%, transparent 50%),
                  linear-gradient(135deg, #fff1f2 0%, #fff7ed 50%, #fdf2f8 100%);
    }

    /* Envelope 3D unfolding effect */
    .envelope-wrapper {
      perspective: 1200px;
    }
    .envelope-card {
      transition: all 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
      transform-style: preserve-3d;
    }
  </style>
</head>
<body class="bg-blobs min-h-screen text-slate-800 font-sans flex flex-col justify-between selection:bg-rose-200 selection:text-rose-900 relative overflow-x-hidden">

  <!-- Floating Ambient Hearts / Stars Canvas in background -->
  <canvas id="ambientCanvas" class="fixed inset-0 pointer-events-none z-0"></canvas>

  <!-- Top Navigation & Header -->
  <header class="w-full max-w-5xl mx-auto px-4 py-6 flex items-center justify-between relative z-10">
    <div class="flex items-center gap-2.5">
      <div class="w-10 h-10 rounded-2xl bg-white/80 shadow-md backdrop-blur-md flex items-center justify-center text-rose-500 border border-white/60">
        <i data-lucide="heart" class="w-5 h-5 fill-rose-500 text-rose-500 animate-pulse-soft"></i>
      </div>
      <div>
        <h1 class="text-lg font-bold tracking-tight text-slate-800">Whispers & Letters</h1>
        <p class="text-xs text-slate-500 font-medium">Personalized for you with love</p>
      </div>
    </div>

    <!-- Admin / Config Trigger Button -->
    <button id="adminBtn" class="flex items-center gap-2 text-xs font-semibold px-3 py-2 rounded-xl bg-white/70 hover:bg-white text-slate-600 hover:text-slate-900 shadow-sm border border-slate-200/60 backdrop-blur-md transition-all hover:shadow active:scale-95">
      <i data-lucide="sliders" class="w-4 h-4 text-rose-400"></i>
      <span class="hidden sm:inline">Manage Secret Codes</span>
    </button>
  </header>

  <!-- Main Content Area -->
  <main class="flex-1 flex items-center justify-center px-4 py-8 relative z-10 w-full max-w-lg mx-auto">

    <!-- VIEW 1: PASSCODE INPUT (LOCKED) -->
    <div id="lockView" class="w-full envelope-wrapper transition-all duration-500 ease-out">
      <div class="bg-white/85 backdrop-blur-xl rounded-3xl p-7 sm:p-9 shadow-2xl shadow-rose-200/50 border border-white/80 relative text-center">
        <!-- Stamp decor -->
        <div class="absolute -top-3.5 right-6 w-9 h-11 bg-rose-100/90 border border-dashed border-rose-300 rounded-sm flex items-center justify-center text-rose-400 transform rotate-6 shadow-sm">
          <i data-lucide="sparkles" class="w-4 h-4"></i>
        </div>

        <div class="w-16 h-16 mx-auto rounded-3xl bg-gradient-to-tr from-rose-400 to-pink-500 text-white flex items-center justify-center shadow-lg shadow-rose-300/60 mb-5 animate-float-slow">
          <i data-lucide="mail" class="w-8 h-8"></i>
        </div>

        <h2 class="text-2xl font-bold tracking-tight text-slate-800">You've Got a Secret Letter!</h2>
        <p class="text-sm text-slate-500 mt-2 max-w-xs mx-auto">Enter your personal passcode to unlock the special message written just for you.</p>

        <!-- Form for passcode entry -->
        <form id="unlockForm" class="mt-6 flex flex-col gap-3.5">
          <div class="relative">
            <input 
              type="text" 
              id="passcodeInput" 
              placeholder="e.g. EMMA2024 or SUNSHINE"
              autocomplete="off"
              spellcheck="false"
              class="w-full text-center tracking-widest uppercase font-semibold text-base py-3.5 px-4 bg-slate-50/80 hover:bg-slate-50 focus:bg-white rounded-2xl border border-slate-200 focus:border-rose-400 focus:ring-4 focus:ring-rose-100 transition outline-none placeholder:text-slate-400 placeholder:tracking-normal placeholder:font-normal placeholder:normal-case shadow-inner"
            />
          </div>

          <button 
            type="submit" 
            class="w-full py-3.5 px-6 rounded-2xl bg-gradient-to-r from-rose-500 via-rose-600 to-pink-600 text-white font-semibold text-sm shadow-lg shadow-rose-500/25 hover:shadow-rose-500/40 hover:-translate-y-0.5 active:translate-y-0 transition-all flex items-center justify-center gap-2 group">
            <span>Unlock My Message</span>
            <i data-lucide="key-round" class="w-4 h-4 transition-transform group-hover:rotate-45"></i>
          </button>
        </form>

        <!-- Hints / Quick Helper -->
        <div class="mt-6 pt-5 border-t border-slate-100 flex flex-col items-center gap-1.5 text-xs text-slate-400">
          <div class="flex items-center gap-1">
            <i data-lucide="help-circle" class="w-3.5 h-3.5 text-slate-400"></i>
            <span>Trying a demo? Try codes:</span>
          </div>
          <div class="flex flex-wrap justify-center gap-1.5 mt-1">
            <button type="button" class="demo-tag font-mono px-2 py-0.5 bg-rose-50 text-rose-600 border border-rose-200/80 rounded-md hover:bg-rose-100 transition" onclick="useDemoCode('ALEX24')">ALEX24</button>
            <button type="button" class="demo-tag font-mono px-2 py-0.5 bg-rose-50 text-rose-600 border border-rose-200/80 rounded-md hover:bg-rose-100 transition" onclick="useDemoCode('BESTIE')">BESTIE</button>
            <button type="button" class="demo-tag font-mono px-2 py-0.5 bg-rose-50 text-rose-600 border border-rose-200/80 rounded-md hover:bg-rose-100 transition" onclick="useDemoCode('SUNSHINE')">SUNSHINE</button>
          </div>
        </div>
      </div>
    </div>

    <!-- VIEW 2: UNLOCKED LETTER CARD -->
    <div id="messageView" class="w-full hidden transition-all duration-700 ease-out transform scale-95 opacity-0">
      <div class="bg-gradient-to-b from-[#fffefc] to-[#fffaf6] rounded-3xl p-6 sm:p-9 shadow-2xl shadow-rose-300/40 border border-amber-100/90 relative overflow-hidden">
        
        <!-- Wax Seal Badge -->
        <div class="w-12 h-12 rounded-full bg-gradient-to-br from-rose-500 to-rose-700 mx-auto text-white flex items-center justify-center shadow-md shadow-rose-600/30 ring-4 ring-rose-100 mb-4 animate-float-slow">
          <i data-lucide="heart-handshake" class="w-6 h-6"></i>
        </div>

        <!-- Greeting Header -->
        <div class="text-center mb-6">
          <span class="inline-block text-xs font-semibold uppercase tracking-wider text-rose-500 bg-rose-50 px-3 py-1 rounded-full border border-rose-100 mb-2">
            A Note Just For You
          </span>
          <h2 id="recipientName" class="text-3xl sm:text-4xl font-handwriting text-slate-800 font-bold">Dear Friend,</h2>
        </div>

        <!-- Avatar / Picture Placeholder -->
        <div id="photoContainer" class="flex justify-center mb-5 hidden">
          <div class="relative p-1.5 bg-white rounded-2xl shadow-md border border-slate-200/60 transform -rotate-1 hover:rotate-0 transition duration-300">
            <img id="recipientPhoto" src="" alt="Photo Memory" class="w-32 h-32 sm:w-36 sm:h-36 object-cover rounded-xl" onerror="this.src='https://placehold.co/200x200/fecdd3/881337?text=Memory'">
            <div class="absolute -bottom-2 -right-2 bg-rose-500 text-white rounded-full p-1 shadow-sm">
              <i data-lucide="smile" class="w-3.5 h-3.5"></i>
            </div>
          </div>
        </div>

        <!-- Letter Body Content -->
        <div class="bg-white/80 rounded-2xl p-5 sm:p-6 shadow-inner border border-amber-100 text-slate-700 relative">
          <!-- Quote Icon -->
          <i data-lucide="quote" class="w-8 h-8 text-rose-200/80 absolute top-3 left-3 -scale-x-100"></i>
          
          <p id="letterContent" class="relative z-10 font-sans text-base leading-relaxed whitespace-pre-wrap pl-3 font-normal text-slate-700">
            Message goes here...
          </p>
        </div>

        <!-- Memories / Tags Pill Section -->
        <div id="tagsContainer" class="mt-4 flex flex-wrap justify-center gap-1.5">
          <!-- Dynamic tags injected here -->
        </div>

        <!-- Sender Sign-off -->
        <div class="mt-6 text-right">
          <p class="text-xs uppercase tracking-widest text-slate-400 font-medium">With heartfelt warmth,</p>
          <p id="senderName" class="text-2xl font-handwriting text-rose-600 font-bold mt-0.5">Your Friend</p>
        </div>

        <!-- Card Action Buttons -->
        <div class="mt-8 pt-5 border-t border-amber-100 flex items-center justify-between gap-3">
          <button id="lockBackBtn" class="flex items-center gap-1.5 text-xs font-semibold px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 transition active:scale-95">
            <i data-lucide="lock" class="w-3.5 h-3.5"></i>
            <span>Lock & Close</span>
          </button>

          <button id="celebrateBtn" class="flex items-center gap-1.5 text-xs font-semibold px-4 py-2.5 rounded-xl bg-rose-100 hover:bg-rose-200 text-rose-700 transition active:scale-95 shadow-sm">
            <i data-lucide="party-popper" class="w-3.5 h-3.5"></i>
            <span>Throw Hearts!</span>
          </button>
        </div>
      </div>
    </div>
  </main>

  <!-- Notification Toast -->
  <div id="toast" class="fixed bottom-6 left-1/2 transform -translate-x-1/2 bg-slate-900 text-white px-5 py-3 rounded-2xl shadow-xl flex items-center gap-2.5 text-xs font-medium opacity-0 pointer-events-none transition-all duration-300 z-50 border border-slate-800">
    <i id="toastIcon" data-lucide="info" class="w-4 h-4 text-rose-400"></i>
    <span id="toastMsg">Notification message</span>
  </div>

  <!-- ADMIN / CUSTOMIZER MODAL -->
  <div id="adminModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-3xl max-w-2xl w-full max-h-[90vh] flex flex-col shadow-2xl overflow-hidden border border-slate-100 animate-in fade-in zoom-in-95 duration-200">
      
      <!-- Modal Header -->
      <div class="p-5 sm:p-6 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
        <div>
          <h3 class="text-lg font-bold text-slate-800 flex items-center gap-2">
            <i data-lucide="settings" class="w-5 h-5 text-rose-500"></i>
            Secret Codes & Messages Manager
          </h3>
          <p class="text-xs text-slate-500 mt-0.5">Customize names, secret unlock passcodes, and special letters.</p>
        </div>
        <button id="closeAdminBtn" class="w-8 h-8 rounded-full bg-slate-200/70 hover:bg-slate-200 flex items-center justify-center text-slate-600 transition">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>

      <!-- Modal Body Tabs & List -->
      <div class="p-5 sm:p-6 overflow-y-auto space-y-6 flex-1">
        
        <!-- Add New Message Form Accordion -->
        <div class="bg-rose-50/50 border border-rose-100 rounded-2xl p-4 sm:p-5">
          <h4 class="text-sm font-bold text-rose-900 flex items-center gap-1.5 mb-3">
            <i data-lucide="user-plus" class="w-4 h-4 text-rose-600"></i>
            <span id="formTitle">Add a New Friend's Secret Note</span>
          </h4>

          <form id="friendEditorForm" class="space-y-3.5">
            <input type="hidden" id="editOriginalCode" value="">

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Friend's Name</label>
                <input type="text" id="inputName" required placeholder="e.g. Maya Lin" class="w-full text-xs py-2 px-3 rounded-xl border border-slate-200 focus:outline-none focus:border-rose-400 focus:ring-2 focus:ring-rose-100">
              </div>

              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Secret Passcode (Case-insensitive)</label>
                <input type="text" id="inputCode" required placeholder="e.g. MAYA2024" class="w-full uppercase font-mono text-xs py-2 px-3 rounded-xl border border-slate-200 focus:outline-none focus:border-rose-400 focus:ring-2 focus:ring-rose-100">
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Signed by (Your Name)</label>
                <input type="text" id="inputSender" placeholder="e.g. Sam" class="w-full text-xs py-2 px-3 rounded-xl border border-slate-200 focus:outline-none focus:border-rose-400 focus:ring-2 focus:ring-rose-100">
              </div>

              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">Photo Image URL (Optional)</label>
                <input type="url" id="inputPhoto" placeholder="https://..." class="w-full text-xs py-2 px-3 rounded-xl border border-slate-200 focus:outline-none focus:border-rose-400 focus:ring-2 focus:ring-rose-100">
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Tags / Shared Memories (Comma separated)</label>
              <input type="text" id="inputTags" placeholder="Coffee dates, Road trips 2023, Unstoppable laugh" class="w-full text-xs py-2 px-3 rounded-xl border border-slate-200 focus:outline-none focus:border-rose-400 focus:ring-2 focus:ring-rose-100">
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Personal Message</label>
              <textarea id="inputMessage" required rows="3" placeholder="Write something sweet, funny, or deep..." class="w-full text-xs py-2 px-3 rounded-xl border border-slate-200 focus:outline-none focus:border-rose-400 focus:ring-2 focus:ring-rose-100"></textarea>
            </div>

            <div class="flex items-center justify-end gap-2 pt-2">
              <button type="button" id="cancelEditBtn" class="hidden px-3 py-1.5 text-xs text-slate-500 hover:text-slate-700">Cancel Edit</button>
              <button type="submit" id="saveFriendBtn" class="px-4 py-2 text-xs font-semibold text-white bg-rose-600 hover:bg-rose-700 rounded-xl shadow-sm transition active:scale-95">Save Secret Note</button>
            </div>
          </form>
        </div>

        <!-- Active List of Messages -->
        <div>
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">All Active Messages (<span id="countLabel">0</span>)</h4>
          <div id="messagesList" class="space-y-2.5">
            <!-- Injected via JS -->
          </div>
        </div>

        <!-- Data Export & Import Helper -->
        <div class="pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3 text-xs">
          <button id="resetDemoBtn" class="text-slate-400 hover:text-rose-500 font-medium">Reset to Demo Data</button>
          <div class="flex gap-2">
            <button id="copyJsonBtn" class="px-3 py-1.5 rounded-lg border border-slate-200 hover:bg-slate-50 text-slate-600 font-medium flex items-center gap-1.5">
              <i data-lucide="copy" class="w-3.5 h-3.5"></i>
              <span>Copy Data Backup</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="p-4 border-t border-slate-100 bg-slate-50 flex justify-end">
        <button id="finishAdminBtn" class="px-5 py-2 rounded-xl bg-slate-900 text-white font-semibold text-xs hover:bg-slate-800 transition">Done</button>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer class="w-full max-w-5xl mx-auto px-4 py-4 text-center text-xs text-slate-400 relative z-10 flex flex-col sm:flex-row items-center justify-between gap-2">
    <span>Made for friends, laughter, and secrets.</span>
    <span>Tip: Open the manager to generate custom links or codes!</span>
  </footer>

  <script>
    // --- DEFAULT INITIAL DATA ---
    const DEFAULT_DATA = {
      "ALEX24": {
        name: "Alex",
        sender: "Sam",
        message: "Hey Alex! Just wanted to remind you how grateful I am for our 2 AM talks, all the crazy road trip playlists, and you always knowing when I need coffee.\n\nYou have an infectious laugh and you make every tough day brighter. Keep being your awesome, unapologetic self!",
        photo: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=400&q=80",
        tags: ["Beach Sunset", "2 AM Ramen", "Best Co-pilot"]
      },
      "BESTIE": {
        name: "Chloe",
        sender: "Your Partner in Crime",
        message: "Happy Birthday / Surprise Bestie!\n\nNo matter how busy life gets, having you in my corner makes everything feel so much lighter. Thanks for believing in my wildest dreams and constantly keeping me grounded.\n\nHere is to a hundred more chapters together! Love you tons!",
        photo: "https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=400&q=80",
        tags: ["Soul Sister", "Unstoppable", "Always Laughing"]
      },
      "SUNSHINE": {
        name: "Jordan",
        sender: "Yours Truly",
        message: "To the person who always brings positive energy into any room they step into:\n\nThank you for always checking up on me, offering great advice, and giving the warmest hugs. Don't forget to take a pause today and celebrate how far you've come!",
        photo: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=400&q=80",
        tags: ["Golden Hour", "Cheerleader", "Good Vibes Only"]
      }
    };

    // Load state from localStorage or use defaults
    let vaultData = {};
    try {
      const stored = localStorage.getItem('whispers_vault_data');
      if (stored) {
        vaultData = JSON.parse(stored);
      } else {
        vaultData = { ...DEFAULT_DATA };
        localStorage.setItem('whispers_vault_data', JSON.stringify(vaultData));
      }
    } catch (e) {
      vaultData = { ...DEFAULT_DATA };
    }

    function saveVaultData() {
      try {
        localStorage.setItem('whispers_vault_data', JSON.stringify(vaultData));
      } catch (e) {
        console.error("Failed to save to localStorage", e);
      }
      renderAdminList();
    }

    // --- DOM ELEMENTS ---
    const lockView = document.getElementById('lockView');
    const messageView = document.getElementById('messageView');
    const unlockForm = document.getElementById('unlockForm');
    const passcodeInput = document.getElementById('passcodeInput');
    const recipientName = document.getElementById('recipientName');
    const senderName = document.getElementById('senderName');
    const letterContent = document.getElementById('letterContent');
    const photoContainer = document.getElementById('photoContainer');
    const recipientPhoto = document.getElementById('recipientPhoto');
    const tagsContainer = document.getElementById('tagsContainer');
    const lockBackBtn = document.getElementById('lockBackBtn');
    const celebrateBtn = document.getElementById('celebrateBtn');
    const adminBtn = document.getElementById('adminBtn');
    const adminModal = document.getElementById('adminModal');
    const closeAdminBtn = document.getElementById('closeAdminBtn');
    const finishAdminBtn = document.getElementById('finishAdminBtn');
    const toast = document.getElementById('toast');
    const toastMsg = document.getElementById('toastMsg');
    const toastIcon = document.getElementById('toastIcon');

    // Admin Elements
    const friendEditorForm = document.getElementById('friendEditorForm');
    const formTitle = document.getElementById('formTitle');
    const editOriginalCode = document.getElementById('editOriginalCode');
    const inputName = document.getElementById('inputName');
    const inputCode = document.getElementById('inputCode');
    const inputSender = document.getElementById('inputSender');
    const inputPhoto = document.getElementById('inputPhoto');
    const inputTags = document.getElementById('inputTags');
    const inputMessage = document.getElementById('inputMessage');
    const cancelEditBtn = document.getElementById('cancelEditBtn');
    const messagesList = document.getElementById('messagesList');
    const countLabel = document.getElementById('countLabel');
    const resetDemoBtn = document.getElementById('resetDemoBtn');
    const copyJsonBtn = document.getElementById('copyJsonBtn');

    // --- TOAST HELPER ---
    let toastTimeout;
    function showToast(message, type = "info") {
      clearTimeout(toastTimeout);
      toastMsg.textContent = message;
      if (type === 'error') {
        toastIcon.setAttribute('data-lucide', 'alert-circle');
        toastIcon.className = "w-4 h-4 text-rose-400";
      } else if (type === 'success') {
        toastIcon.setAttribute('data-lucide', 'check-circle-2');
        toastIcon.className = "w-4 h-4 text-emerald-400";
      } else {
        toastIcon.setAttribute('data-lucide', 'sparkles');
        toastIcon.className = "w-4 h-4 text-amber-400";
      }
      lucide.createIcons();
      toast.classList.remove('opacity-0', 'pointer-events-none');
      toastTimeout = setTimeout(() => {
        toast.classList.add('opacity-0', 'pointer-events-none');
      }, 3000);
    }

    // --- CELEBRATION PARTICLES / CONFETTI ---
    function triggerConfetti() {
      if (typeof confetti === 'function') {
        // Heart & star blast
        confetti({
          particleCount: 65,
          spread: 70,
          origin: { y: 0.6 },
          colors: ['#f43f5e', '#fb7185', '#fda4af', '#fcd34d', '#e0e7ff'],
          shapes: ['circle']
        });
        setTimeout(() => {
          confetti({
            particleCount: 40,
            angle: 60,
            spread: 55,
            origin: { x: 0 },
            colors: ['#fb7185', '#ec4899', '#f43f5e']
          });
          confetti({
            particleCount: 40,
            angle: 120,
            spread: 55,
            origin: { x: 1 },
            colors: ['#fb7185', '#ec4899', '#f43f5e']
          });
        }, 200);
      }
    }

    // --- UNLOCK MESSAGE LOGIC ---
    function unlockWithCode(code) {
      if (!code) return;
      const cleanCode = code.trim().toUpperCase();

      if (vaultData[cleanCode]) {
        const item = vaultData[cleanCode];

        // Fill data
        recipientName.textContent = `Dear ${item.name || 'Friend'},`;
        senderName.textContent = item.sender ? item.sender : 'Your Friend';
        letterContent.textContent = item.message;

        if (item.photo && item.photo.trim() !== '') {
          recipientPhoto.src = item.photo;
          photoContainer.classList.remove('hidden');
        } else {
          photoContainer.classList.add('hidden');
        }

        // Render tags
        tagsContainer.innerHTML = '';
        if (item.tags && Array.isArray(item.tags) && item.tags.length > 0) {
          item.tags.forEach(t => {
            const span = document.createElement('span');
            span.className = "text-[11px] font-medium bg-rose-100/70 text-rose-800 px-2.5 py-0.5 rounded-full border border-rose-200/50";
            span.textContent = `#${t.trim()}`;
            tagsContainer.appendChild(span);
          });
        }

        // Transition views smoothly
        lockView.classList.add('opacity-0', 'scale-90');
        setTimeout(() => {
          lockView.classList.add('hidden');
          messageView.classList.remove('hidden');
          setTimeout(() => {
            messageView.classList.remove('opacity-0', 'scale-95');
            triggerConfetti();
          }, 50);
        }, 300);

      } else {
        // Wrong code: shake animation & feedback
        lockView.classList.add('animate-shake');
        setTimeout(() => lockView.classList.remove('animate-shake'), 450);
        showToast("Incorrect passcode! Ask your friend for the secret key.", "error");
      }
    }

    // Quick helper for demo buttons
    window.useDemoCode = function(code) {
      passcodeInput.value = code;
      unlockWithCode(code);
    };

    unlockForm.addEventListener('submit', (e) => {
      e.preventDefault();
      unlockWithCode(passcodeInput.value);
    });

    // Lock back
    lockBackBtn.addEventListener('click', () => {
      messageView.classList.add('opacity-0', 'scale-95');
      setTimeout(() => {
        messageView.classList.add('hidden');
        lockView.classList.remove('hidden');
        passcodeInput.value = '';
        setTimeout(() => {
          lockView.classList.remove('opacity-0', 'scale-90');
        }, 50);
      }, 300);
    });

    celebrateBtn.addEventListener('click', triggerConfetti);

    // --- URL PARAM AUTO-UNLOCK (e.g. ?code=ALEX24) ---
    window.addEventListener('DOMContentLoaded', () => {
      lucide.createIcons();
      renderAdminList();
      initAmbientCanvas();

      // Check URL query param
      const urlParams = new URLSearchParams(window.location.search);
      const codeFromUrl = urlParams.get('code');
      if (codeFromUrl) {
        passcodeInput.value = codeFromUrl;
        setTimeout(() => {
          unlockWithCode(codeFromUrl);
        }, 400);
      }
    });

    // --- ADMIN / CUSTOMIZER PANEL LOGIC ---
    adminBtn.addEventListener('click', () => {
      adminModal.classList.remove('hidden');
      renderAdminList();
    });

    closeAdminBtn.addEventListener('click', () => {
      adminModal.classList.add('hidden');
      resetEditorForm();
    });

    finishAdminBtn.addEventListener('click', () => {
      adminModal.classList.add('hidden');
      resetEditorForm();
    });

    function resetEditorForm() {
      friendEditorForm.reset();
      editOriginalCode.value = '';
      formTitle.textContent = "Add a New Friend's Secret Note";
      cancelEditBtn.classList.add('hidden');
    }

    cancelEditBtn.addEventListener('click', resetEditorForm);

    friendEditorForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const code = inputCode.value.trim().toUpperCase();
      const originalCode = editOriginalCode.value.trim().toUpperCase();

      if (!code) return;

      const tags = inputTags.value
        .split(',')
        .map(t => t.trim())
        .filter(t => t.length > 0);

      // If we are renaming an existing code
      if (originalCode && originalCode !== code) {
        delete vaultData[originalCode];
      }

      vaultData[code] = {
        name: inputName.value.trim(),
        sender: inputSender.value.trim() || 'Your Friend',
        message: inputMessage.value.trim(),
        photo: inputPhoto.value.trim(),
        tags: tags
      };

      saveVaultData();
      resetEditorForm();
      showToast(`Secret code "${code}" saved!`, "success");
    });

    function renderAdminList() {
      const keys = Object.keys(vaultData);
      countLabel.textContent = keys.length;
      messagesList.innerHTML = '';

      if (keys.length === 0) {
        messagesList.innerHTML = `<p class="text-xs text-slate-400 italic text-center py-4">No letters yet. Add one above!</p>`;
        return;
      }

      keys.forEach(code => {
        const item = vaultData[code];
        const card = document.createElement('div');
        card.className = "flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-200/80 hover:bg-slate-100/60 transition gap-3";

        // Current page URL for direct link sharing
        const shareLink = `${window.location.origin}${window.location.pathname}?code=${encodeURIComponent(code)}`;

        card.innerHTML = `
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <span class="font-bold text-xs text-slate-800">${item.name}</span>
              <span class="font-mono text-[10px] font-semibold bg-rose-100 text-rose-700 px-2 py-0.5 rounded-md border border-rose-200">${code}</span>
            </div>
            <p class="text-[11px] text-slate-500 truncate mt-0.5">${item.message}</p>
          </div>

          <div class="flex items-center gap-1.5 flex-shrink-0">
            <button title="Copy Shareable Link" class="p-1.5 text-slate-400 hover:text-rose-600 rounded-lg hover:bg-white" onclick="copyShareLink('${code}')">
              <i data-lucide="share-2" class="w-3.5 h-3.5"></i>
            </button>
            <button title="Edit" class="p-1.5 text-slate-400 hover:text-slate-800 rounded-lg hover:bg-white" onclick="editFriend('${code}')">
              <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
            </button>
            <button title="Delete" class="p-1.5 text-slate-400 hover:text-rose-600 rounded-lg hover:bg-white" onclick="deleteFriend('${code}')">
              <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
            </button>
          </div>
        `;
        messagesList.appendChild(card);
      });

      lucide.createIcons();
    }

    window.editFriend = function(code) {
      const item = vaultData[code];
      if (!item) return;

      editOriginalCode.value = code;
      inputCode.value = code;
      inputName.value = item.name || '';
      inputSender.value = item.sender || '';
      inputPhoto.value = item.photo || '';
      inputTags.value = (item.tags || []).join(', ');
      inputMessage.value = item.message || '';

      formTitle.textContent = `Edit Letter for ${item.name} (${code})`;
      cancelEditBtn.classList.remove('hidden');
      document.getElementById('friendEditorForm').scrollIntoView({ behavior: 'smooth' });
    };

    window.deleteFriend = function(code) {
      delete vaultData[code];
      saveVaultData();
      showToast(`Removed note for ${code}`, "info");
    };

    window.copyShareLink = function(code) {
      const shareUrl = `${window.location.origin}${window.location.pathname}?code=${encodeURIComponent(code)}`;
      copyToClipboardText(shareUrl);
      showToast(`Copied link for passcode "${code}"!`, "success");
    };

    function copyToClipboardText(text) {
      const tempInput = document.createElement("input");
      tempInput.style.position = "absolute";
      tempInput.style.left = "-9999px";
      tempInput.value = text;
      document.body.appendChild(tempInput);
      tempInput.select();
      document.execCommand("copy");
      document.body.removeChild(tempInput);
    }

    copyJsonBtn.addEventListener('click', () => {
      const json = JSON.stringify(vaultData, null, 2);
      copyToClipboardText(json);
      showToast("Data copied to clipboard!", "success");
    });

    resetDemoBtn.addEventListener('click', () => {
      vaultData = { ...DEFAULT_DATA };
      saveVaultData();
      showToast("Restored demo friends and messages!", "info");
    });

    // --- AMBIENT FLOATING HEARTS & PARTICLES (HTML5 CANVAS) ---
    function initAmbientCanvas() {
      const canvas = document.getElementById('ambientCanvas');
      const ctx = canvas.getContext('2d');
      let width, height;

      function resize() {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
      }
      window.addEventListener('resize', resize);
      resize();

      const particles = [];
      const particleCount = 28;

      for (let i = 0; i < particleCount; i++) {
        particles.push({
          x: Math.random() * width,
          y: Math.random() * height,
          size: Math.random() * 9 + 4,
          speedY: Math.random() * 0.4 + 0.15,
          speedX: (Math.random() - 0.5) * 0.25,
          opacity: Math.random() * 0.4 + 0.1,
          isHeart: Math.random() > 0.45
        });
      }

      function drawHeart(x, y, size) {
        ctx.save();
        ctx.translate(x, y);
        ctx.beginPath();
        const topCurveHeight = size * 0.3;
        ctx.moveTo(0, topCurveHeight);
        ctx.bezierCurveTo(0, 0, -size / 2, 0, -size / 2, topCurveHeight);
        ctx.bezierCurveTo(-size / 2, (size + topCurveHeight) / 2, 0, (size + topCurveHeight) / 1.3, 0, size);
        ctx.bezierCurveTo(0, (size + topCurveHeight) / 1.3, size / 2, (size + topCurveHeight) / 2, size / 2, topCurveHeight);
        ctx.bezierCurveTo(size / 2, 0, 0, 0, 0, topCurveHeight);
        ctx.closePath();
        ctx.fill();
        ctx.restore();
      }

      function animate() {
        ctx.clearRect(0, 0, width, height);

        for (let p of particles) {
          ctx.fillStyle = `rgba(244, 63, 94, ${p.opacity})`;
          if (p.isHeart) {
            drawHeart(p.x, p.y, p.size);
          } else {
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.size / 2, 0, Math.PI * 2);
            ctx.fill();
          }

          p.y -= p.speedY;
          p.x += p.speedX;

          if (p.y < -20) {
            p.y = height + 20;
            p.x = Math.random() * width;
          }
          if (p.x < -20) p.x = width + 20;
          if (p.x > width + 20) p.x = -20;
        }

        requestAnimationFrame(animate);
      }
      animate();
    }
  </script>
</body>
</html>
